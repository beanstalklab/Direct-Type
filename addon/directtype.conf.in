# Addon metadata. fcitx5 reads this file to know that
# <addon dir>/directtype.so is an input method engine and what it provides.
[Addon]
Name=Direct Type
Comment=Direct typing for Vietnamese: keystrokes reach the application immediately
Category=InputMethod
Version=@PROJECT_VERSION@
Type=SharedLibrary
Library=directtype
# False because the input methods are listed by the engine itself, not by files under
# share/fcitx5/inputmethod/ - see listInputMethods() in src/engine.cpp.
OnDemand=False
# The settings come from getConfig(), so fcitx5 builds the config UI from them.
Configurable=True

[Addon/Dependencies]
0=core
